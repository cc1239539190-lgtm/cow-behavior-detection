          <mxGeometry x="55" y="166" width="690" height="30" as="geometry" />
        </mxCell>

        <!-- ===== 目标检测模块 ===== -->
        <mxCell id="detect-box" value="目标检测模块" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;fontSize=12;fontStyle=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="240" height="160" as="geometry" />
        </mxCell>
        <mxCell id="detect-items" value="· YOLOv11 深度学习目标检测模型&lt;br&gt;· ONNX Runtime Web 推理引擎&lt;br&gt;· NMS 非极大值抑制后处理&lt;br&gt;· 图像预处理 (letterbox 640×640)&lt;br&gt;· 输出：站立/行走/躺卧/进食/饮水&lt;br&gt;· 输出：置信度 + 边界框坐标" style="text;html=1;align=left;verticalAlign=top;fontSize=9;spacingLeft=5;spacingTop=35;" vertex="1" parent="1">
          <mxGeometry x="45" y="245" width="230" height="145" as="geometry" />
        </mxCell>

        <!-- ===== 异常检测引擎模块 ===== -->
        <mxCell id="anomaly-box" value="异常检测引擎模块" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#D32F2F;fontSize=12;fontStyle=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="300" y="240" width="240" height="160" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-items" value="· 时间窗口状态机算法&lt;br&gt;· resting 持续 &gt; 3min → warning 警告&lt;br&gt;· resting 持续 &gt; 10min → critical 严重&lt;br&gt;· 每 15s 轮询摄像头在线状态&lt;br&gt;· &gt; 30s 无数据 → camera_offline&lt;br&gt;· 防重复告警机制（同类型不重复）" style="text;html=1;align=left;verticalAlign=top;fontSize=9;spacingLeft=5;spacingTop=35;" vertex="1" parent="1">
          <mxGeometry x="305" y="245" width="230" height="145" as="geometry" />
        </mxCell>

