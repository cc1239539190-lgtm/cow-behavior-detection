          <mxGeometry x="560" y="240" width="200" height="310" as="geometry" />
        </mxCell>
        <mxCell id="api-items" value="· POST /api/detection&lt;br&gt;   （接收检测数据）&lt;br&gt;· GET  /api/detection&lt;br&gt;   （查询检测历史）&lt;br&gt;· GET  /api/stats&lt;br&gt;   （仪表盘统计）&lt;br&gt;· GET  /api/alerts&lt;br&gt;   （告警列表）&lt;br&gt;· POST /api/alerts&lt;br&gt;   （手动创建告警）&lt;br&gt;· PATCH /api/alerts&lt;br&gt;   （确认处理告警）" style="text;html=1;align=left;verticalAlign=top;fontSize=9;spacingLeft=8;spacingTop=35;" vertex="1" parent="1">
